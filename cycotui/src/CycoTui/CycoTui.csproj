<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;netstandard2.0;netstandard2.1</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <RootNamespace>CycoAI.CycoTui</RootNamespace>
    <AssemblyName>CycoAI.CycoTui</AssemblyName>
  </PropertyGroup>

  <!-- Enable ImplicitUsings only for .NET 9.0 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CycoAI.CycoTui</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <Title>CycoTui</Title>
    <Description>Terminal UI framework for .NET - A C# port of Ratatui</Description>
    <Authors>CycoAI</Authors>
    <PackageTags>terminal;tui;console;ui;ratatui</PackageTags>
    <RepositoryUrl>https://github.com/cycoai/cycotui</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CycoTui.Core/CycoTui.Core.csproj" />
  </ItemGroup>

</Project>
